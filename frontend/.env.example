VITE_API_URL=http://localhost:5000/api

# Floating WhatsApp button: digits only, with country code (e.g. 9779800000000).
# Leave empty to use the number from Site settings / SUPPORT_WHATSAPP_NUMBER;
# if both are empty the button opens WhatsApp's contact picker with the message.
VITE_WHATSAPP_NUMBER=
VITE_WHATSAPP_MESSAGE=Hi ScrapMate, I need help with scrap pickup

# Not needed: maps use OpenStreetMap tiles in the browser, and address search
# goes through the API (which uses MAPS_API_KEY when set). Kept for parity.
VITE_MAPS_KEY=
