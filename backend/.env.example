# ---------- Server ----------
PORT=5000
NODE_ENV=development
# Frontend origin(s), comma separated. Used for CORS, cookies and links in emails.
CLIENT_URL=http://localhost:5173
# Public URL of this API (used for locally stored upload URLs).
PUBLIC_API_URL=http://localhost:5000
SOCKET_CORS_ORIGIN=http://localhost:5173
# Set to 1 behind a proxy/load balancer (Render, Nginx, Docker compose).
TRUST_PROXY=
LOG_LEVEL=info
API_RATE_LIMIT=600
AUTH_RATE_LIMIT=20

# ---------- Database ----------
# Local, Atlas (mongodb+srv://...), or a replica set (enables transactions).
MONGODB_URI=mongodb://127.0.0.1:27017/scrapmate

# ---------- Auth ----------
# Production requires a long random secret (32+ chars).
JWT_SECRET=change_this_dev_secret_key
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_DAYS=30
COOKIE_NAME=scrapmate_token
# 'lax' when frontend and API share a site; 'none' (with HTTPS) when they don't.
COOKIE_SAMESITE=lax

# ---------- AI chat assistant (optional: rule-based bot without a key) ----------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_EFFORT=low
# Server-side refusal fallback (Claude API only). "off" for other platforms/models.
ANTHROPIC_FALLBACKS=default
CHAT_RATE_LIMIT_PER_MIN=12

# ---------- Support / WhatsApp (admins can override in Site settings) ----------
# Digits with country code, e.g. 9779800000000
SUPPORT_WHATSAPP_NUMBER=
SUPPORT_HOURS_START=9
SUPPORT_HOURS_END=20
SUPPORT_TIMEZONE=Asia/Kathmandu
SUPPORT_REPLY_MINUTES=10
DEFAULT_CITY=Kathmandu
# Country timezone for slots, "today" and dates (Nepal: +05:45).
APP_TIMEZONE=Asia/Kathmandu
APP_UTC_OFFSET=+05:45
# WhatsApp Cloud API for outgoing notifications (logs to console when missing)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# ---------- SMS / OTP (console OTP when missing) ----------
# 'sparrow' (Sparrow SMS, Nepal) or 'twilio'
SMS_PROVIDER=sparrow
SPARROW_SMS_TOKEN=
# Sender identity approved by Sparrow SMS
SPARROW_SMS_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ---------- Email (console when missing) ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ---------- Payments (mock orders/payouts when missing) ----------
# Khalti ePayment for business invoices. Use the live key with
# KHALTI_BASE_URL=https://khalti.com/api/v2 in production.
KHALTI_SECRET_KEY=
KHALTI_BASE_URL=https://dev.khalti.com/api/v2
# Optional payout API for eSewa/Khalti/bank transfers to customers. Without it,
# payouts are queued in production and finance marks them paid in Admin > Finance.
PAYOUT_PROVIDER_URL=
PAYOUT_PROVIDER_TOKEN=

# ---------- Images (saved under ./uploads when missing) ----------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------- Maps (OpenStreetMap / Nominatim when missing) ----------
MAPS_API_KEY=

# ---------- Web push (in-app/email/WhatsApp still work without it) ----------
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@scrapmate.dev
